# Partition table — use partitions-4mb.csv for 4MB flash (default),
# partitions.csv for 8MB+ flash
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-4mb.csv"

# Flash size must match the partition table above. esp32 and esp32c3 default to
# 2MB, which the 4MB table does not fit — set it here so every target agrees.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# NimBLE
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# WiFi
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# OTA - allow plain HTTP
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# DHCP captive portal support
CONFIG_LWIP_DHCPS=y
CONFIG_ESP_ENABLE_DHCP_CAPTIVEPORTAL=y

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
