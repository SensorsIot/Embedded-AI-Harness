# Partition table — use partitions-4mb.csv for 4MB flash (default),
# partitions.csv for 8MB+ flash
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-4mb.csv"

# Flash size must match the partition table above. esp32 and esp32c3 default to
# 2MB, which the 4MB table does not fit — set it here so every target agrees.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# NimBLE
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# WiFi
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# OTA - allow plain HTTP
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# DHCP captive portal support
CONFIG_LWIP_DHCPS=y
CONFIG_ESP_ENABLE_DHCP_CAPTIVEPORTAL=y

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# PHY calibration: recalibrate every boot, never trust stored data.
#
# An ESP32-S3 on this bench stopped transmitting WiFi entirely after a
# full-erase flash — SoftAP logged as started, no beacon on the air, while
# BLE from the same chip stayed plainly visible to a scanner. Calibration
# data lives in NVS, a full erase takes it with everything else, and a
# partial recalibration from missing or stale data can leave the radio
# initialised and mute. A DUT that gets erased and reflashed several times a
# day cannot carry that risk; the cost is about 100 ms of boot time.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# Console on the native USB port, not UART0.
#
# The default puts the primary console on UART0 (GPIO43/44) and mirrors it to
# USB-Serial/JTAG as a *secondary* console. Secondary is output only. So the
# bench could read this device perfectly and could not talk to it at all:
# bytes written to the slot went to a peripheral nothing was listening on,
# and the console's replies left through pins no cable touches. Everything
# looked plausible from both ends.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ...and only once. The secondary console defaults to USB-Serial/JTAG too, so
# once the primary moved there every log line went out the same peripheral
# twice. A bench matching a pattern still passes on doubled output, but a test
# that counts lines — heartbeats, markers, a reply — silently sees two of
# everything.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
